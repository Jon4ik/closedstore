# Use Node.js 20 with Debian
FROM node:20-bookworm-slim

# Install dependencies
RUN apt-get update && apt-get install -y \
    openssl \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source
COPY . .

# Generate Prisma client
RUN npx prisma generate

# Build with TypeScript compiler directly (more reliable than nest build)
RUN echo "=== Building with tsc ===" && \
    npx tsc --version && \
    npx tsc -p tsconfig.json 2>&1 || (echo "=== TypeScript compilation failed ===" && exit 1)

# Verify build
RUN echo "=== Checking build output ===" && \
    ls -la && \
    if [ -d "dist" ]; then \
      echo "✅ dist directory exists" && \
      ls -la dist/ && \
      if [ -f "dist/main.js" ]; then \
        echo "✅ main.js exists"; \
      else \
        echo "❌ main.js not found in dist/" && \
        find dist -name "*.js" | head -20; \
      fi; \
    else \
      echo "❌ dist directory not found" && \
      exit 1; \
    fi

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:4000/api/health || exit 1

CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]
