# ============================================
# Конфигурация системы "Реконструкция — Закрытие"
# ============================================

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DB_HOST=postgres
DB_PORT=5432
DB_NAME=store_reconstruction
DB_USER=postgres
DB_SSL=false

# JWT Authentication
JWT_SECRET=CHANGE_ME_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Backend
NODE_ENV=production
API_PORT=4000

# Domain (для SSL и CORS)
DOMAIN=reconstruction.yourcompany.ru

# pgAdmin (опционально)
PGADMIN_EMAIL=admin@company.ru
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# Email notifications (опционально)
SMTP_HOST=smtp.yourcompany.ru
SMTP_PORT=587
SMTP_USER=noreply@yourcompany.ru
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM=Реконструкция <noreply@yourcompany.ru>
